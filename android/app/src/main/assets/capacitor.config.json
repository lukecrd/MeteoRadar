{
	"appId": "com.meteoradar.italy",
	"appName": "MeteoRadar 3D & Storm Track",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "https",
		"cleartext": true
	},
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": true,
		"backgroundColor": "#091422"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"backgroundColor": "#091422",
			"showSpinner": true,
			"androidSpinnerStyle": "large",
			"spinnerColor": "#2dd4bf"
		}
	}
}
